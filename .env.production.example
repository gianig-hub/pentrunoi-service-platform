# Production environment example
# Copy to .env on the production VPS and edit privately.
# Never commit real production secrets.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_SITE_URL=https://pentrunoi.ro

DATABASE_URL=postgresql://pentrunoi:CHANGE_STRONG_PASSWORD@db:5432/pentrunoi_service_platform?schema=public

POSTGRES_USER=pentrunoi
POSTGRES_PASSWORD=CHANGE_STRONG_PASSWORD
POSTGRES_DB=pentrunoi_service_platform

UPLOADS_DIR=/app/uploads
MAX_UPLOAD_MB=10

ADMIN_EMAIL=gianig@gmail.com
PUBLIC_CONTACT_EMAIL=contact@pentrunoi.ro

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pentrunoi.ro <contact@pentrunoi.ro>
